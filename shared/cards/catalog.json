  {
   "id": "quadratic",
   "s": "algebra",
   "n": {
    "en": "Quadratic equation",
    "ru": "Квадратное уравнение",
    "es": "Ecuación cuadrática"
   },
   "k": {
    "en": "quadratic discriminant roots parabola second degree",
    "ru": "квадратное уравнение дискриминант корни парабола",
    "es": "cuadratica discriminante raices parabola"
   },
   "form": "ax^2+bx+c=0",
   "f": [
    {
     "id": "a",
     "l": "a"
    },
    {
     "id": "b",
     "l": "b"
    },
    {
     "id": "c",
     "l": "c"
    }
   ],
   "need": [
    {
     "if": "a != 0",
     "show": "a \\neq 0"
    }
   ],
   "steps": [
    {
     "tex": "D = b^2 - 4ac"
    },
    {
     "tex": "D = (@b)^2 - 4\\cdot(@a)\\cdot(@c)"
    },
    {
     "set": "D = b**2 - 4*a*c"
    },
    {
     "tex": "D = @D"
    },
    {
     "when": "D > 0",
     "steps": [
      {
       "tex": "x_{1,2} = \\frac{-b \\pm \\sqrt{D}}{2a}"
      },
      {
       "set": "x1 = (-b + sqrt(D))/(2*a)"
      },
      {
       "set": "x2 = (-b - sqrt(D))/(2*a)"
      },
      {
       "tex": "x_1 = @x1,\\qquad x_2 = @x2"
      }
     ],
     "else": [
      {
       "when": "D = 0",
       "steps": [
        {
         "tex": "D = 0 \\Rightarrow x_1 = x_2 = -\\frac{b}{2a}"
        },
        {
         "set": "x1 = -b/(2*a)"
        },
        {
         "tex": "x = @x1"
        }
       ],
       "else": [
        {
         "tex": "D < 0 \\Rightarrow x \\notin \\mathbb{R}"
        },
        {
         "set": "x1 = (-b + sqrt(D))/(2*a)"
        },
        {
         "set": "x2 = (-b - sqrt(D))/(2*a)"
        },
        {
         "tex": "x_{1,2} = @x1,\\quad @x2"
        }
       ]
      }
     ]
    }
   ],
   "try": {
    "a": "1",
    "b": "-5",
    "c": "6"
   }
  },
  {
   "id": "vieta",
   "s": "algebra",
   "n": {
    "en": "Vieta's formulas",
    "ru": "Теорема Виета",
    "es": "Fórmulas de Vieta"
   },
   "k": {
    "en": "vieta sum product of roots reduced",
    "ru": "виета сумма произведение корней приведённое",
    "es": "vieta suma producto raices"
   },
   "form": "x^2+px+q=0",
   "f": [
    {
     "id": "p",
     "l": "p"
    },
    {
     "id": "q",
     "l": "q"
    }
   ],
   "steps": [
    {
     "tex": "x_1 + x_2 = -p,\\qquad x_1 x_2 = q"
    },
    {
     "set": "S = -p"
    },
    {
     "set": "P = q"
    },
    {
     "tex": "x_1 + x_2 = -(@p) = @S"
    },
    {
     "tex": "x_1 x_2 = @P"
    },
    {
     "set": "D = p**2 - 4*q"
    },
    {
     "tex": "D = (@p)^2 - 4\\cdot(@q) = @D"
    },
    {
     "when": "D >= 0",
     "steps": [
      {
       "set": "x1 = (-p + sqrt(D))/2"
      },
      {
       "set": "x2 = (-p - sqrt(D))/2"
      },
      {
       "tex": "x_1 = @x1,\\qquad x_2 = @x2"
      }
     ],
     "else": [
      {
       "tex": "D < 0 \\Rightarrow x \\notin \\mathbb{R}"
      }
     ]
    }
   ],
   "try": {
    "p": "-7",
    "q": "12"
   }
  },
