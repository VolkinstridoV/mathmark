       "set": "i11 = d/D"
      },
      {
       "set": "i12 = -b/D"
      },
      {
       "set": "i21 = -c/D"
      },
      {
       "set": "i22 = a/D"
      },
      {
       "tex": "A^{-1} = \\begin{pmatrix} @i11 & @i12 \\\\ @i21 & @i22 \\end{pmatrix}"
      }
     ],
     "else": [
      {
       "tex": "\\Delta = 0 \\Rightarrow \\nexists\\, A^{-1}"
      }
     ]
    }
   ],
