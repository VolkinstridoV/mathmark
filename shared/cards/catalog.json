    },
    {
     "if": "p <= 1",
     "show": "p \\leq 1"
    }
   ],
   "steps": [
    {
     "set": "C = binomial(n, k)"
    },
    {
     "tex": "\\binom{@n}{@k} = @C"
    },
    {
     "set": "P = C*p**k*(1-p)**(n-k)"
    },
    {
     "tex": "P(X=@k) = @C\\cdot(@p)^{@k}(1-@p)^{@n-@k} = @P"
    },
    {
     "set": "E = n*p"
    },
    {
     "set": "D = n*p*(1-p)"
