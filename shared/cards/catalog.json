    "es": "minimos cuadrados regresion recta"
   },
   "form": "y = kx + b,\\qquad k = \\frac{\\overline{xy} - \\bar x\\bar y}{\\overline{x^2} - \\bar x^2}",
   "f": [
    {
     "id": "xs",
     "l": "x_i",
     "t": "list"
    },
    {
     "id": "ys",
     "l": "y_i",
     "t": "list"
    }
   ],
   "need": [
    {
     "if": "len(xs) == len(ys)",
     "show": "|x| = |y|"
    },
    {
     "if": "len(xs) > 1",
     "show": "n > 1"
    }
   ],
   "steps": [
    {
     "set": "nn = len(xs)"
    },
    {
     "set": "mx = sum(xs)/len(xs)"
    },
    {
     "set": "my = sum(ys)/len(ys)"
    },
    {
     "tex": "\\bar x = @mx,\\qquad \\bar y = @my"
    },
    {
     "set": "mxy = sum([xs[i]*ys[i] for i in range(len(xs))])/len(xs)"
    },
    {
     "set": "mx2 = sum([v**2 for v in xs])/len(xs)"
    },
    {
     "tex": "\\overline{xy} = @mxy,\\qquad \\overline{x^2} = @mx2"
    },
    {
     "when": "sum([v**2 for v in xs])/len(xs) - (sum(xs)/len(xs))**2 != 0",
     "steps": [
      {
       "set": "k = (mxy - mx*my)/(mx2 - mx**2)"
      },
      {
       "set": "b = my - k*mx"
      },
      {
       "tex": "k = \\frac{@mxy - @mx\\cdot @my}{@mx2 - (@mx)^2} = @k"
      },
      {
       "tex": "b = @my - @k\\cdot @mx = @b"
      },
      {
       "tex": "y = @k\\,x + @b"
      }
     ],
     "else": [
      {
       "tex": "\\overline{x^2} - \\bar x^2 = 0 \\Rightarrow \\nexists\\, k"
      }
     ]
    }
   ],
   "try": {
    "xs": "1,2,3,4",
    "ys": "2,4,5,8"
   }
  }
 ]
