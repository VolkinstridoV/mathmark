   "form": "\\vec a\\cdot\\vec b = |\\vec a||\\vec b|\\cos\\varphi",
   "f": [
    {
     "id": "ax",
     "l": "a_x"
    },
    {
     "id": "ay",
     "l": "a_y"
    },
    {
     "id": "az",
     "l": "a_z"
    },
    {
     "id": "bx",
     "l": "b_x"
    },
    {
     "id": "by",
