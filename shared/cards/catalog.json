    "es": "logaritmo base potencia"
   },
   "form": "\\log_a b = x \\iff a^x = b",
   "f": [
    {
     "id": "a",
     "l": "a"
    },
    {
     "id": "b",
     "l": "b"
    }
   ],
   "need": [
    {
     "if": "a > 0",
     "show": "a > 0"
    },
    {
     "if": "a != 1",
     "show": "a \\neq 1"
    },
    {
     "if": "b > 0",
     "show": "b > 0"
    }
   ],
   "steps": [
    {
     "tex": "\\log_a b = \\frac{\\ln b}{\\ln a}"
    },
    {
     "set": "x = log(b)/log(a)"
    },
    {
     "tex": "\\log_{@a} @b = \\frac{\\ln @b}{\\ln @a} = @x"
    },
    {
     "set": "xf = N(x, 8)"
    },
    {
     "tex": "\\approx @xf"
    }
   ],
   "try": {
    "a": "2",
    "b": "8"
   }
  },
