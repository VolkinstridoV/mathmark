    {
     "id": "bz",
     "l": "b_z"
    }
   ],
   "steps": [
    {
     "set": "s = ax*bx + ay*by + az*bz"
    },
    {
     "tex": "\\vec a\\cdot\\vec b = @ax\\cdot @bx + @ay\\cdot @by + @az\\cdot @bz = @s"
    },
    {
     "set": "na = sqrt(ax**2 + ay**2 + az**2)"
    },
    {
     "set": "nb = sqrt(bx**2 + by**2 + bz**2)"
    },
    {
     "tex": "|\\vec a| = @na,\\qquad |\\vec b| = @nb"
    },
    {
     "when": "(ax**2+ay**2+az**2)*(bx**2+by**2+bz**2) > 0",
     "steps": [
      {
       "set": "cf = s/(na*nb)"
      },
      {
       "tex": "\\cos\\varphi = \\frac{@s}{@na\\cdot @nb} = @cf"
      },
      {
       "set": "phi = acos(cf)*180/pi"
      },
      {
       "set": "phif = N(phi, 6)"
      },
      {
       "tex": "\\varphi \\approx @phif^\\circ"
      }
     ],
     "else": [
      {
       "tex": "|\\vec a||\\vec b| = 0 \\Rightarrow \\nexists\\,\\varphi"
      }
     ]
    }
   ],
