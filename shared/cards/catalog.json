    "es": "Teorema de Bayes"
   },
   "k": {
    "en": "bayes conditional probability posterior prior",
    "ru": "байес условная вероятность апостериорная",
    "es": "bayes probabilidad condicional"
   },
   "form": "P(A\\mid B) = \\frac{P(B\\mid A)P(A)}{P(B)}",
   "f": [
    {
     "id": "pa",
     "l": "P(A)"
    },
    {
     "id": "pba",
     "l": "P(B\\mid A)"
    },
    {
     "id": "pbna",
     "l": "P(B\\mid \\bar A)"
    }
   ],
   "need": [
    {
     "if": "pa >= 0",
     "show": "P(A) \\geq 0"
    },
    {
     "if": "pa <= 1",
     "show": "P(A) \\leq 1"
    },
    {
     "if": "pba >= 0",
     "show": "P(B\\mid A) \\geq 0"
    },
    {
     "if": "pba <= 1",
     "show": "P(B\\mid A) \\leq 1"
    },
    {
     "if": "pbna >= 0",
     "show": "P(B\\mid \\bar A) \\geq 0"
    },
    {
     "if": "pbna <= 1",
     "show": "P(B\\mid \\bar A) \\leq 1"
    }
   ],
   "steps": [
    {
     "tex": "P(B) = P(B\\mid A)P(A) + P(B\\mid \\bar A)P(\\bar A)"
    },
    {
     "set": "pb = pba*pa + pbna*(1-pa)"
    },
    {
     "tex": "P(B) = @pba\\cdot @pa + @pbna\\cdot(1-@pa) = @pb"
    },
    {
     "when": "pba*pa + pbna*(1-pa) > 0",
     "steps": [
      {
       "set": "post = pba*pa/pb"
      },
      {
       "tex": "P(A\\mid B) = \\frac{@pba\\cdot @pa}{@pb} = @post"
      },
      {
       "set": "pf = N(post, 8)"
      },
      {
       "tex": "\\approx @pf"
      }
     ],
     "else": [
      {
       "tex": "P(B) = 0 \\Rightarrow \\nexists\\, P(A\\mid B)"
      }
     ]
    }
   ],
   "try": {
    "pa": "0.01",
    "pba": "0.9",
    "pbna": "0.05"
   }
  },
