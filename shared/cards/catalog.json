   ],
   "steps": [
    {
     "tex": "\\Delta = ad - bc"
    },
    {
     "set": "D = a*d - b*c"
    },
    {
     "tex": "\\Delta = (@a)(@d) - (@b)(@c) = @D"
    },
    {
     "when": "a*d - b*c != 0",
     "steps": [
      {
       "tex": "A^{-1} = \\frac{1}{\\Delta}\\begin{pmatrix} d & -b \\\\ -c & a \\end{pmatrix}"
      },
