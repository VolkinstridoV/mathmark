   },
   "form": "a^n,\\qquad \\sqrt[n]{a}",
   "f": [
    {
     "id": "a",
     "l": "a"
    },
    {
     "id": "n",
     "l": "n"
    }
   ],
   "steps": [
    {
     "set": "P = a**n"
    },
    {
     "tex": "a^n = (@a)^{@n} = @P"
    },
    {
     "when": "a >= 0",
     "steps": [
      {
       "set": "R = a**(1/n)"
      },
      {
       "tex": "\\sqrt[@n]{@a} = @R"
      },
      {
       "set": "Rf = N(R, 8)"
      },
      {
       "tex": "\\approx @Rf"
      }
     ],
     "else": [
      {
       "tex": "a < 0 \\Rightarrow \\sqrt[n]{a} \\notin \\mathbb{R}\\ \\ (2 \\mid n)"
      }
     ]
    }
   ],
   "try": {
    "a": "16",
    "n": "4"
   }
  },
  {
   "id": "arith",
   "s": "seq",
   "n": {
    "en": "Arithmetic progression",
    "ru": "Арифметическая прогрессия",
    "es": "Progresión aritmética"
   },
   "k": {
    "en": "arithmetic progression difference nth term sum",
    "ru": "арифметическая прогрессия разность член сумма",
    "es": "aritmetica progresion diferencia suma"
   },
   "form": "a_n = a_1 + (n-1)d",
   "f": [
    {
     "id": "a1",
     "l": "a_1"
    },
    {
     "id": "d",
     "l": "d"
    },
    {
     "id": "n",
     "l": "n"
    }
   ],
   "need": [
    {
     "if": "n > 0",
     "show": "n > 0"
    }
   ],
   "steps": [
    {
     "tex": "a_n = a_1 + (n-1)d"
    },
    {
     "set": "an = a1 + (n-1)*d"
    },
    {
     "tex": "a_{@n} = @a1 + (@n-1)\\cdot @d = @an"
    },
    {
     "tex": "S_n = \\frac{(a_1+a_n)n}{2}"
    },
    {
     "set": "S = (a1 + an)*n/2"
    },
    {
     "tex": "S_{@n} = \\frac{(@a1 + @an)\\cdot @n}{2} = @S"
    }
   ],
   "try": {
    "a1": "2",
    "d": "3",
    "n": "10"
   }
  },
  {
   "id": "geomprog",
   "s": "seq",
   "n": {
    "en": "Geometric progression",
    "ru": "Геометрическая прогрессия",
    "es": "Progresión geométrica"
   },
   "k": {
    "en": "geometric progression ratio sum infinite",
    "ru": "геометрическая прогрессия знаменатель сумма бесконечная",
    "es": "geometrica progresion razon suma"
   },
   "form": "b_n = b_1 q^{\\,n-1}",
   "f": [
    {
     "id": "b1",
     "l": "b_1"
    },
    {
     "id": "q",
     "l": "q"
    },
    {
     "id": "n",
     "l": "n"
    }
   ],
   "need": [
    {
     "if": "n > 0",
     "show": "n > 0"
    }
   ],
   "steps": [
    {
     "tex": "b_n = b_1q^{\\,n-1}"
    },
    {
     "set": "bn = b1*q**(n-1)"
    },
    {
     "tex": "b_{@n} = @b1\\cdot(@q)^{@n-1} = @bn"
    },
    {
     "when": "q != 1",
     "steps": [
      {
       "tex": "S_n = b_1\\frac{q^n-1}{q-1}"
      },
      {
       "set": "S = b1*(q**n - 1)/(q - 1)"
      },
      {
       "tex": "S_{@n} = @S"
      }
     ],
     "else": [
      {
       "set": "S = b1*n"
      },
      {
       "tex": "q=1 \\Rightarrow S_{@n} = @S"
      }
     ]
    },
    {
     "when": "Abs(q) < 1",
     "steps": [
      {
       "tex": "S_\\infty = \\frac{b_1}{1-q}"
      },
      {
       "set": "Sinf = b1/(1-q)"
      },
      {
       "tex": "S_\\infty = @Sinf"
      }
     ]
    }
   ],
   "try": {
    "b1": "1",
    "q": "1/2",
    "n": "5"
   }
  },
  {
   "id": "binom",
   "s": "seq",
   "n": {
    "en": "Binomial coefficient",
    "ru": "Биномиальный коэффициент",
    "es": "Coeficiente binomial"
   },
   "k": {
    "en": "binomial coefficient combinations choose pascal",
    "ru": "биномиальный коэффициент сочетания число выборок паскаль",
    "es": "binomial combinaciones"
   },
   "form": "\\binom{n}{k} = \\frac{n!}{k!\\,(n-k)!}",
   "f": [
    {
     "id": "n",
     "l": "n"
    },
    {
     "id": "k",
     "l": "k"
    }
   ],
   "need": [
    {
     "if": "n >= 0",
     "show": "n \\geq 0"
    },
    {
     "if": "k >= 0",
     "show": "k \\geq 0"
    },
    {
     "if": "k <= n",
     "show": "k \\leq n"
    }
   ],
   "steps": [
    {
     "tex": "\\binom{n}{k} = \\frac{n!}{k!\\,(n-k)!}"
    },
    {
     "tex": "\\binom{@n}{@k} = \\frac{@n!}{@k!\\,(@n-@k)!}"
    },
    {
     "set": "C = binomial(n, k)"
    },
    {
     "tex": "= @C"
    }
   ],
   "try": {
    "n": "10",
    "k": "3"
   }
  },
  {
   "id": "factorial",
   "s": "seq",
   "n": {
    "en": "Factorial and permutations",
    "ru": "Факториал и перестановки",
    "es": "Factorial y permutaciones"
   },
   "k": {
    "en": "factorial permutations arrangements",
    "ru": "факториал перестановки размещения",
    "es": "factorial permutaciones"
   },
   "form": "n! = 1\\cdot2\\cdots n",
   "f": [
    {
     "id": "n",
     "l": "n"
    },
    {
     "id": "k",
     "l": "k"
    }
   ],
   "need": [
    {
     "if": "n >= 0",
     "show": "n \\geq 0"
    },
    {
     "if": "k >= 0",
     "show": "k \\geq 0"
    },
    {
     "if": "k <= n",
     "show": "k \\leq n"
    }
   ],
   "steps": [
    {
     "set": "F = factorial(n)"
    },
    {
     "tex": "@n! = @F"
    },
    {
     "tex": "A_n^k = \\frac{n!}{(n-k)!}"
    },
    {
     "set": "A = factorial(n)/factorial(n-k)"
    },
    {
     "tex": "A_{@n}^{@k} = \\frac{@n!}{(@n-@k)!} = @A"
    }
   ],
   "try": {
    "n": "6",
    "k": "2"
   }
  },
  {
   "id": "trigval",
   "s": "trig",
   "n": {
    "en": "Sine, cosine, tangent of an angle",
    "ru": "Синус, косинус, тангенс угла",
    "es": "Seno, coseno, tangente"
   },
   "k": {
    "en": "sine cosine tangent angle degrees radians",
    "ru": "синус косинус тангенс угол градусы радианы",
    "es": "seno coseno tangente angulo grados"
   },
   "form": "\\sin\\alpha,\\ \\cos\\alpha,\\ \\tan\\alpha",
   "f": [
    {
     "id": "deg",
     "l": "\\alpha^\\circ"
    }
   ],
   "steps": [
    {
     "tex": "\\alpha = @deg^\\circ = \\frac{@deg\\pi}{180}"
    },
    {
     "set": "r = deg*pi/180"
    },
    {
     "tex": "\\alpha = @r"
    },
    {
     "set": "s = sin(r)"
    },
    {
     "set": "c = cos(r)"
    },
    {
     "tex": "\\sin\\alpha = @s,\\qquad \\cos\\alpha = @c"
    },
    {
     "when": "cos(deg*pi/180) != 0",
     "steps": [
      {
       "set": "t = tan(r)"
      },
      {
       "tex": "\\tan\\alpha = @t"
      }
     ],
     "else": [
      {
       "tex": "\\cos\\alpha = 0 \\Rightarrow \\tan\\alpha \\text{ —}\\ \\nexists"
      }
     ]
    },
    {
     "set": "sf = N(s, 8)"
    },
    {
     "set": "cf = N(c, 8)"
    },
    {
     "tex": "\\approx @sf,\\qquad @cf"
    }
   ],
   "try": {
    "deg": "30"
   }
  },
  {
   "id": "pythag",
   "s": "trig",
   "n": {
    "en": "Pythagorean theorem",
    "ru": "Теорема Пифагора",
    "es": "Teorema de Pitágoras"
   },
   "k": {
    "en": "pythagoras hypotenuse leg right triangle",
    "ru": "пифагор гипотенуза катет прямоугольный треугольник",
    "es": "pitagoras hipotenusa cateto"
   },
   "form": "a^2 + b^2 = c^2",
   "f": [
    {
     "id": "a",
     "l": "a"
    },
    {
     "id": "b",
     "l": "b"
    }
   ],
   "need": [
    {
     "if": "a > 0",
     "show": "a > 0"
    },
    {
     "if": "b > 0",
     "show": "b > 0"
    }
   ],
   "steps": [
    {
     "tex": "c = \\sqrt{a^2+b^2}"
    },
    {
     "set": "c = sqrt(a**2 + b**2)"
    },
    {
     "tex": "c = \\sqrt{(@a)^2 + (@b)^2} = @c"
    },
    {
     "set": "cf = N(c, 8)"
