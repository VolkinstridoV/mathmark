  {
   "id": "lineq2",
   "s": "algebra",
   "n": {
    "en": "System of two linear equations",
    "ru": "Система двух линейных уравнений",
    "es": "Sistema de dos ecuaciones lineales"
   },
   "k": {
    "en": "system two linear cramer substitution",
    "ru": "система двух линейных уравнений крамер подстановка",
    "es": "sistema dos lineales cramer"
   },
   "form": "\\begin{cases} a_1x + b_1y = c_1 \\\\ a_2x + b_2y = c_2 \\end{cases}",
   "f": [
    {
     "id": "a1",
     "l": "a_1"
    },
    {
     "id": "b1",
     "l": "b_1"
    },
    {
     "id": "c1",
     "l": "c_1"
    },
    {
     "id": "a2",
     "l": "a_2"
    },
    {
     "id": "b2",
     "l": "b_2"
    },
    {
     "id": "c2",
     "l": "c_2"
    }
   ],
   "need": [
    {
     "if": "a1*b2 - a2*b1 != 0",
     "show": "a_1b_2 - a_2b_1 \\neq 0"
    }
   ],
   "steps": [
    {
     "tex": "\\Delta = \\begin{vmatrix} a_1 & b_1 \\\\ a_2 & b_2 \\end{vmatrix} = a_1b_2 - a_2b_1"
    },
    {
     "set": "D = a1*b2 - a2*b1"
    },
    {
     "tex": "\\Delta = (@a1)(@b2) - (@a2)(@b1) = @D"
    },
    {
     "set": "Dx = c1*b2 - c2*b1"
    },
    {
     "set": "Dy = a1*c2 - a2*c1"
    },
    {
     "tex": "\\Delta_x = c_1b_2 - c_2b_1 = @Dx,\\qquad \\Delta_y = a_1c_2 - a_2c_1 = @Dy"
    },
    {
     "set": "x = Dx/D"
    },
    {
     "set": "y = Dy/D"
    },
    {
     "tex": "x = \\frac{\\Delta_x}{\\Delta} = @x,\\qquad y = \\frac{\\Delta_y}{\\Delta} = @y"
    }
   ],
   "try": {
    "a1": "2",
    "b1": "3",
    "c1": "8",
    "a2": "1",
    "b2": "-1",
    "c2": "1"
   }
  },
  {
   "id": "logeq",
   "s": "algebra",
   "n": {
